#!/usr/bin/env bash
# Garante que o script pare se houver erros
set -eu

# Descobre a pasta onde este script (RUN_ME) está localizado
SCRIPT_DIR="$(dirname "$(realpath "$0")")"

# Define o caminho para a pasta do programa (ajustado para a sua versão)
TARGET_DIR="$SCRIPT_DIR/ACCELA-20260425230142-linux"
INSTALL_SCRIPT="$TARGET_DIR/ACCELAINSTALL"

echo "========================================="
echo "  Iniciando o instalador do ACCELA...    "
echo "========================================="

# Verifica se o script de instalação realmente existe
if [ -f "$INSTALL_SCRIPT" ]; then
    # Dá permissão de execução para o instalador, caso não tenha
    chmod +x "$INSTALL_SCRIPT"
    
    # Entra na pasta do instalador (necessário para o ACCELAINSTALL achar a pasta 'bin')
    cd "$TARGET_DIR"
    
    # Executa o instalador
    ./ACCELAINSTALL
else
    echo -e "\n[ERRO] Não foi possível encontrar o script do instalador em:"
    echo "$INSTALL_SCRIPT"
    echo "Verifique se a estrutura de pastas está correta."
    exit 1
fi
